from alpha_vantage.timeseries import TimeSeries
from alpha_vantage.techindicators import TechIndicators
import pandas as pd

API_KEY = 'YOUR_ALPHA_VANTAGE_KEY'

# 1. Get Stock Prices (OHLCV)
ts = TimeSeries(key=API_KEY, output_format='pandas')
# 'full' gets up to 20 years of data for your warehouse
price_data, meta_data = ts.get_daily(symbol='AAPL', outputsize='full')

ti = TechIndicators(key=API_KEY, output_format='pandas')
sma_data, sma_meta = ti.get_sma(symbol='AAPL', interval='daily', time_period=20)

df = price_data.join(sma_data).dropna()
print(df.head())